# VULN-SPOT #16: this training build intentionally hard-codes every secret in docker-compose.yml.
# Compose only substitutes the NON-SECRET knobs below; the credential values are IGNORED and kept
# only to show what a secure build would configure. Do not run this build anywhere but your own machine.

# ----- Read by docker compose -----
POSTGRES_USER=trollnet
FRONTEND_PORT=8080                 # 127.0.0.1 port the web app is published on
DEV_TOOLS=false                    # true = expose the /api/dev/* testing console and the Dev tab (hands out flags)
GAME_TICK_SECONDS=60
GAME_OBJECTIVE_LIFETIME_MINUTES=10
GAME_MAX_ACTIVE_OBJECTIVES=3

# ----- Ignored here (hard-coded in docker-compose.yml for VULN-SPOT #16) -----
# A hardened build would inject these; this lab does not read them.
POSTGRES_PASSWORD=change_me_postgres_password
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars   # needs >= 32 chars; openssl rand -hex 32
INTERNAL_API_KEY=change_me_internal_api_key                      # shared X-Internal-Key for service-to-service calls
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                                                   # leave empty to skip creating the admin account
