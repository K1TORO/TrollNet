# VULN-SPOT #16: this training build intentionally hard-codes all secrets in docker-compose.yml,
# so the credential values below are ignored. Only the port/game tuning values are still read from .env.
# Do not run this build anywhere other than your own machine.

POSTGRES_USER=trollnet
POSTGRES_PASSWORD=change_me_postgres_password

# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# Shared key for service-to-service calls (at least 16 characters).
INTERNAL_API_KEY=change_me_internal_api_key

# Optional teacher/admin account. Leave ADMIN_PASSWORD empty to skip creating it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Port on 127.0.0.1 where the web app is published.
FRONTEND_PORT=8080

# Game engine tuning.
GAME_TICK_SECONDS=60
GAME_OBJECTIVE_LIFETIME_MINUTES=10
GAME_MAX_ACTIVE_OBJECTIVES=3
