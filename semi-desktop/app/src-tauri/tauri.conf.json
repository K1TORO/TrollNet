{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrollNet",
  "version": "0.1.0",
  "identifier": "com.trollnet.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TrollNet",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "externalBin": ["binaries/trollnet-host"],
    "resources": ["../../../frontend/dist", "../../runtime/llama-b12819", "../../model"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
