{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core window permissions plus spawning/killing the bundled host sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/trollnet-host", "sidecar": true, "args": true }
      ]
    }
  ]
}
