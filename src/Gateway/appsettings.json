{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Append" } ]
      },
      "posts": {
        "ClusterId": "social",
        "Match": { "Path": "/api/posts/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Append" } ]
      },
      "comments": {
        "ClusterId": "social",
        "Match": { "Path": "/api/comments/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Append" } ]
      },
      "objectives": {
        "ClusterId": "game",
        "Match": { "Path": "/api/objectives/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Append" } ]
      },
      "scores": {
        "ClusterId": "game",
        "Match": { "Path": "/api/scores/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Append" } ]
      },
      // VULN-SPOT #06 (CWE-918): INTENTIONAL — expose the link-preview SSRF endpoint.
      "link-preview": {
        "ClusterId": "game",
        "Match": { "Path": "/api/link-preview" },
        "Transforms": [ { "X-Forwarded": "Append" } ]
      },
      // VULN-SPOT #08 (CWE-306): INTENTIONAL — /internal/* is proxied to the social service.
      "internal-posts": {
        "ClusterId": "social",
        "Match": { "Path": "/internal/posts/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Append" } ]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": { "primary": { "Address": "http://auth-service:8080/" } }
      },
      "social": {
        "Destinations": { "primary": { "Address": "http://social-service:8080/" } }
      },
      "game": {
        "Destinations": { "primary": { "Address": "http://game-service:8080/" } }
      }
    }
  }
}
